# WordPress coding standards style. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{package.json,composer.json}]
indent_style = tab

[*.txt]
trim_trailing_whitespace = false

[LICENSE]
indent_style = unset
insert_final_newline = unset
