<?xml version="1.0"?>
<ruleset name="oha.deals">
	<description>Coding standards for the oha.deals plugin.</description>

	<file>.</file>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/.git/*</exclude-pattern>
	<exclude-pattern>/docs/*</exclude-pattern>
	<!-- Generated by `npm run make-l10n`. -->
	<exclude-pattern>/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="./"/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>
	<arg name="colors"/>

	<!-- Compatibility. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Standards. -->
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="oha-deals"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="oha_deals"/>
				<element value="OhaDeals"/>
				<element value="OHA_DEALS"/>
			</property>
		</properties>
	</rule>

	<!-- includes/ follows PSR-4 (Class.php, namespaces), not the WordPress class-*.php convention. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>/includes/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>/includes/*</exclude-pattern>
	</rule>

	<!-- Tests may use short-hand constructs and non-prefixed globals in bootstrap files. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		Test methods are named after the behaviour they check (test_unknown_shipping_is_never_free), so a docblock
		would only repeat the name. WordPress core's own test suite does not document test methods either. Helpers and classes in tests are still documented.
	-->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/phpunit/*Test\.php$</exclude-pattern>
	</rule>
</ruleset>
