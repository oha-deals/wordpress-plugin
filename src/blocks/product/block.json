{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "oha-deals/product",
	"title": "oha.deals Product",
	"category": "oha-deals",
	"description": "Shows one product with its best price and shop offers from oha.deals.",
	"keywords": [
		"price",
		"product",
		"comparison",
		"offer",
		"deal"
	],
	"textdomain": "oha-deals",
	"version": "1.0.0",
	"attributes": {
		"slug": {
			"type": "string",
			"default": ""
		},
		"ean": {
			"type": "string",
			"default": ""
		},
		"layout": {
			"type": "string",
			"enum": [
				"card",
				"compact",
				"inline"
			],
			"default": "card"
		},
		"showImage": {
			"type": "boolean",
			"default": true
		},
		"offersLimit": {
			"type": "number",
			"default": 3
		},
		"showHistory": {
			"type": "boolean",
			"default": false
		},
		"buttonText": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true,
		"interactivity": {
			"interactive": true,
			"clientNavigation": true
		}
	},
	"example": {
		"attributes": {
			"slug": "__example__"
		},
		"viewportWidth": 640
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "oha-deals-frontend"
}
