{
	"name": "oha-deals",
	"version": "1.0.0",
	"private": true,
	"description": "Live price comparisons, deals and price history from oha.deals for WordPress.",
	"author": "oha.deals",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"plugin",
		"blocks",
		"price comparison",
		"deals"
	],
	"homepage": "https://github.com/oha-deals/wordpress-plugin#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oha-deals/wordpress-plugin.git"
	},
	"bugs": {
		"url": "https://github.com/oha-deals/wordpress-plugin/issues"
	},
	"engines": {
		"node": ">=20.10.0",
		"npm": ">=10.2.3"
	},
	"files": [
		"oha-deals.php",
		"uninstall.php",
		"readme.txt",
		"LICENSE",
		"includes/**",
		"templates/**",
		"assets/**",
		"build/**",
		"patterns/**",
		"languages/**"
	],
	"devDependencies": {
		"@wordpress/a11y": "^5.2.0",
		"@wordpress/api-fetch": "^8.2.0",
		"@wordpress/block-editor": "^20.1.0",
		"@wordpress/blocks": "^17.2.0",
		"@wordpress/components": "^45.0.0",
		"@wordpress/core-data": "^9.2.0",
		"@wordpress/data": "^11.2.0",
		"@wordpress/element": "^10.2.0",
		"@wordpress/env": "^12.2.0",
		"@wordpress/hooks": "^5.2.0",
		"@wordpress/i18n": "^7.2.0",
		"@wordpress/interactivity": "^8.2.0",
		"@wordpress/scripts": "^37.2.0",
		"@wordpress/shortcode": "^5.2.0",
		"@wordpress/url": "^5.2.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"scripts": {
		"prebuild": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
		"build": "wp-scripts build --experimental-modules --source-path=src/blocks --output-path=build/blocks",
		"postbuild": "npm run build:manifest",
		"build:manifest": "wp-scripts build-blocks-manifest --input=build/blocks --output=build/blocks-manifest.php",
		"prestart": "npm run build",
		"start": "wp-scripts start --experimental-modules --source-path=src/blocks --output-path=build/blocks",
		"lint:js": "wp-scripts lint-js src assets/admin",
		"lint:js:fix": "wp-scripts lint-js src assets/admin --fix",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\" \"assets/**/*.css\"",
		"test:js": "wp-scripts test-unit-js",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"format": "wp-scripts format src",
		"make-pot": "npm run build && wp-env run cli wp i18n make-pot . languages/oha-deals.pot --slug=oha-deals --domain=oha-deals --exclude=node_modules,vendor,src,tests,.github,docs,demo,plugin-check-build",
		"make-l10n": "wp-env run cli wp i18n make-mo languages && wp-env run cli wp i18n make-php languages && wp-env run cli wp i18n make-json languages --no-purge",
		"plugin-zip": "npm run build && wp-scripts plugin-zip",
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop"
	}
}
